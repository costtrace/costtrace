{
  "name": "@costtrace/mcp",
  "version": "0.3.0",
  "description": "MCP server that lets AI agents ask CostTrace what a code or infrastructure change actually cost.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "costtrace-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@costtrace/core": "0.3.0",
    "@costtrace/focus": "0.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "costtrace": "0.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@costtrace/aws": "0.3.0",
    "@costtrace/azure": "0.3.0",
    "@costtrace/gcp": "0.3.0"
  },
  "peerDependenciesMeta": {
    "@costtrace/aws": {
      "optional": true
    },
    "@costtrace/azure": {
      "optional": true
    },
    "@costtrace/gcp": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costtrace/costtrace.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "finops",
    "focus",
    "cloud-cost",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude"
  ],
  "homepage": "https://costtrace.io",
  "bugs": {
    "url": "https://github.com/costtrace/costtrace/issues"
  }
}
